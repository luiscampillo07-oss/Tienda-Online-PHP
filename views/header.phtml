<?php
// Asegurar que la sesión esté activa antes de leer $SESSION
if (session_status() === PHP_SESSION_NONE) {
    session_start();
}

// Calcular la cantidad total de unidades en el carrito sin lanzar warnings
$cantCarrito = 0;
if (isset($_SESSION['carrito']) && is_array($_SESSION['carrito'])) {
    $cantCarrito = array_sum(array_column($_SESSION['carrito'], 'cantidad'));
}
?>
